      "item": [
        {
          "id": "819f919a-531c-4fcf-9098-38e655c39655",
          "name": "Get OHLC historical data",
          "request": {
            "name": "Get OHLC historical data",
            "description": {
              "content": "Retrieves historical Open-High-Low-Close (OHLC) price data for a given ticker symbol at the specified timeframe and date range. This data is used for charting, backtesting strategies, and performing technical analysis. Level2 provides access to over 200,000 stocks and financial instruments from 75 global exchanges.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "olhc",
                ":api_key",
                ":ticker",
                ":timeframe",
                ":range"
              ],
              "host": [
                "valhalla",
                "bytemine",
                "workers",
                "dev"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "api_key",
                  "description": "(Required) Your Level2 API key used to authenticate requests. Obtain this from your Level2 account dashboard."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticker",
                  "description": "(Required) The stock ticker symbol to query (e.g., AAPL, MSFT, TSLA). Level2 supports over 200,000 instruments from 75 global exchanges."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "timeframe",
                  "description": "(Required) The chart timeframe for the analysis or data retrieval. Common values include 1m, 5m, 15m, 30m, 1h, 4h, 1d, 1w, and 1M representing minutes, hours, days, weeks, and months respectively."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "range",
                  "description": "(Required) The historical date range for OHLC data retrieval. Specifies how far back to fetch data (e.g., 1d, 5d, 1mo, 3mo, 6mo, 1y, 5y, max)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
