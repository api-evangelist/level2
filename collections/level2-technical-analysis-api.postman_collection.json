        {
          "id": "6fd573c7-74ab-4385-9013-643dac5d66c7",
          "name": "Check for candlestick patterns",
          "request": {
            "name": "Check for candlestick patterns",
            "description": {
              "content": "Detects and returns candlestick patterns identified for a given ticker symbol at the specified timeframe. The endpoint analyzes recent price action and identifies recognized candlestick formations such as doji, hammer, engulfing, and other standard patterns used in technical analysis.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "checkForCandlestick",
                ":api_key",
                ":ticker",
                ":timeframe"
              ],
              "host": [
                "app",
                "bytemine",
                "io"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "api_key",
                  "description": "(Required) Your Level2 API key used to authenticate requests. Obtain this from your Level2 account dashboard."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticker",
                  "description": "(Required) The stock ticker symbol to query (e.g., AAPL, MSFT, TSLA). Level2 supports over 200,000 instruments from 75 global exchanges."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "timeframe",
                  "description": "(Required) The chart timeframe for the analysis or data retrieval. Common values include 1m, 5m, 15m, 30m, 1h, 4h, 1d, 1w, and 1M representing minutes, hours, days, weeks, and months respectively."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
